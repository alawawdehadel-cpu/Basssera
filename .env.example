# بصيرة — Firebase client configuration
#
# Copy this file to `.env` and fill in the values from:
#   Firebase Console → Project settings → General → Your apps → Web app → SDK setup
#
# These EXPO_PUBLIC_* values are NOT secrets. Firebase client config is designed
# to ship inside the app; access is controlled by Firestore/Storage security
# rules, not by hiding the key. They live in .env only so the project id is not
# hard-coded in source.
#
# NEVER put any of these in this project:
#   - a Firebase service-account JSON  (import scripts only, via GOOGLE_APPLICATION_CREDENTIALS)
#   - a Firebase Admin SDK private key
#   - any AI provider API key
# The Admin SDK must never be imported by the Expo app.

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExample_replace_me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional. Set to "1" to point the app at local Firebase emulators during
# development. Requires a JDK for the Firestore emulator. Never set in a
# production build.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0

# ---------------------------------------------------------------------------
# Import scripts only (scripts/firebase/*). NOT read by the app.
# Point this at a downloaded service-account key. The path is gitignored;
# keep the key outside the repo if you can.
#
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
